{
	"name": "parse-standard-args",
	"version": "0.1.0",
	"description": "Parses CLI args with node:util parseArgs and a Standard Schema, with friendly errors and generated help.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JoshuaKGoldberg/parse-standard-args.git"
	},
	"license": "MIT",
	"author": {
		"name": "Josh Goldberg",
		"email": "git@joshuakgoldberg.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./dist/index.mjs"
	},
	"files": [
		"dist/"
	],
	"scripts": {
		"build": "tsdown",
		"format": "prettier .",
		"lint": "eslint . --max-warnings 0",
		"lint:knip": "knip",
		"lint:spelling": "cspell \"**\" \".github/**/*\"",
		"prepare": "husky",
		"test": "vitest"
	},
	"lint-staged": {
		"*": "prettier --ignore-unknown --write"
	},
	"devDependencies": {
		"@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
		"@eslint/js": "10.0.1",
		"@eslint/markdown": "8.0.3",
		"@release-it/conventional-changelog": "12.0.0",
		"@types/node": "26.6.2",
		"@vitest/coverage-v8": "5.0.1",
		"@vitest/eslint-plugin": "1.6.27",
		"console-fail-test": "0.9.0",
		"cspell": "10.3.3",
		"eslint": "10.12.0",
		"eslint-plugin-jsdoc": "65.0.1",
		"eslint-plugin-jsonc": "3.4.1",
		"eslint-plugin-markdown-links": "0.9.1",
		"eslint-plugin-n": "18.4.0",
		"eslint-plugin-package-json": "1.10.0",
		"eslint-plugin-perfectionist": "5.12.0",
		"eslint-plugin-regexp": "3.3.1",
		"eslint-plugin-yml": "3.8.1",
		"husky": "9.1.7",
		"knip": "6.39.0",
		"lint-staged": "17.6.0",
		"prettier": "3.9.9",
		"prettier-plugin-curly": "0.4.1",
		"prettier-plugin-packagejson": "3.0.2",
		"prettier-plugin-padding-lines": "0.1.0",
		"prettier-plugin-sentences-per-line": "0.2.4",
		"prettier-plugin-sh": "0.20.0",
		"release-it": "21.1.0",
		"tsdown": "0.23.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.71.0",
		"vitest": "5.0.1"
	},
	"packageManager": "pnpm@11.22.0",
	"engines": {
		"node": "^22.13.0 || ^24.11.0 || >=26.0.0"
	}
}
